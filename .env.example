NODE_ENV=development
PORT=3315
HOST=127.0.0.1
# true for normal VPS operation; set false for headed testing with Xvfb.
PLAYWRIGHT_HEADLESS=true
# Optional: Connect to external undetected browser via CDP (e.g. SeleniumBase UC mode on http://127.0.0.1:9222).
# Leave empty to use built-in native stealth Chromium.
PLAYWRIGHT_CDP_URL=
# Number of parallel research jobs the worker can process simultaneously (default: 1).
WORKER_CONCURRENCY=1
FRONTEND_ORIGIN=http://localhost:5173

# Diisi ketika modul Turso mulai diaktifkan.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Private-app login. Required in production.
AUTH_USERNAME=
AUTH_USER_ID=local-user
# Format: scrypt$N$r$p$base64urlSalt$base64urlDerivedKey
AUTH_PASSWORD_HASH=
# Generate a long random value; this signs the HttpOnly session cookie.
AUTH_SESSION_SECRET=
AUTH_SESSION_TTL_HOURS=168

# Required to encrypt user-owned Gemini API keys at rest. Generate a random 32-byte key.
GEMINI_ENCRYPTION_KEY=
