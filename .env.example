NODE_ENV=development
PORT=3315
HOST=127.0.0.1
# true for normal VPS operation; set false for headed testing with Xvfb.
PLAYWRIGHT_HEADLESS=true
# Optional: Connect to external undetected browser via CDP (e.g. SeleniumBase UC mode on http://127.0.0.1:9222).
# Leave empty to use built-in native stealth Chromium.
PLAYWRIGHT_CDP_URL=
# Number of parallel research jobs the worker can process simultaneously (default: 1).
WORKER_CONCURRENCY=1
FRONTEND_ORIGIN=http://localhost:5173

# Diisi ketika modul Turso mulai diaktifkan.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Clerk server verification. Required in production.
CLERK_SECRET_KEY=
# Optional alternative: PEM value from Clerk Dashboard -> JWKS Public Key.
# Store the PEM on one line with escaped newlines when needed.
CLERK_JWT_KEY=
CLERK_PUBLISHABLE_KEY=
# Every authenticated Clerk user can access monitoring, settings, Gemini, and proxies.
CLERK_AUTHORIZED_PARTIES=http://localhost:5173
CLERK_JWT_AUDIENCE=

# Required to encrypt user-owned Gemini API keys at rest. Generate a random 32-byte key.
GEMINI_ENCRYPTION_KEY=

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
