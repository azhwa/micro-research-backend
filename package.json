{
  "name": "microstock-research-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend for the Microstock Research MVP",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:scoring": "tsx src/services/insights.scoring.test.ts",
    "validate:scoring": "tsx src/scripts/validate-scoring.ts",
    "test:stealth": "tsx src/crawlers/stealth.test.ts",
    "auth:hash": "tsx src/scripts/hash-password.ts",
    "db:backup": "tsx src/scripts/backup-database.ts",
    "db:migrate-local": "tsx src/scripts/migrate-turso-to-local.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@google/genai": "^2.22.0",
    "@libsql/client": "^0.15.9",
    "crawlee": "^3.15.0",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.4.0",
    "playwright": "1.62.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.19.4",
    "typescript": "^5.9.2"
  }
}
